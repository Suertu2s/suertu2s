# =============================================================================
# Suertu2s — Variables de Entorno (.env.local)
# Configuración para Supabase, Vercel, Cloudflare, Flow.cl y Resend
# =============================================================================

# OBLIGATORIO en producción: dominio HTTPS real (callbacks Flow y emails)
NEXT_PUBLIC_SITE_URL=https://suertu2s.cl

# -----------------------------------------------------------------------------
# 1. Supabase Database (Recomendado para Producción en Vercel)
# Obtenlas en https://supabase.com -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 2. Hostinger / MySQL Database (Opcional - solo si no usas Supabase)
# Dejar vacío si usas Supabase o modo memoria/demo local
# -----------------------------------------------------------------------------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_SSL=true

# -----------------------------------------------------------------------------
# 3. Cloudflare & Proxying
# Actívalo en producción cuando estés detrás de Cloudflare y/o Vercel
# -----------------------------------------------------------------------------
TRUST_PROXY=true

# -----------------------------------------------------------------------------
# 4. Pagos y Pasarelas
# En local, mock activo por defecto. En producción siempre desactivado.
# -----------------------------------------------------------------------------
# PAYMENTS_MOCK=false

# Flow.cl Pasarela de Pagos (Webpay, Servipag, tarjetas en Chile)
# En producción: FLOW_ENV=production (sandbox solo para pruebas)
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=sandbox

# -----------------------------------------------------------------------------
# 5. Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Suertu2s <contacto@suertu2s.cl>

# -----------------------------------------------------------------------------
# 6. Autenticación Administrador
# -----------------------------------------------------------------------------
ADMIN_EMAILS=admin@suertu2s.cl
ADMIN_PASSWORD=change-me-strong-password
# Preferido en producción: hash scrypt (formato scrypt$salt$hash). Si está, se ignora ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=
# Obligatorio en producción (no reutilices la contraseña, usa una clave aleatoria larga)
ADMIN_SESSION_SECRET=change-me-long-random-secret

# -----------------------------------------------------------------------------
# 7. Portal de Afiliados
# -----------------------------------------------------------------------------
# AFFILIATE_SESSION_SECRET=
AFFILIATE_DEMO_PASSWORD=afiliado-demo

# -----------------------------------------------------------------------------
# 8. Redes Sociales
# -----------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/suertu2s/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61590580826151
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@suertu2s

# Sentry Monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
